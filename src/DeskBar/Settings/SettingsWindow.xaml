<Window x:Class="DeskBar.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskBar.Settings"
        Title="DeskBar settings" Width="640" Height="760" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="Not" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Open data folder" Padding="12,4" Click="OpenDataFolder_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Padding="20,4" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
                    <Button Content="Cancel" Padding="16,4" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <GroupBox Header="Appearance">
                    <StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Position on screen" Style="{StaticResource Label}" />
                            <ComboBox Grid.Column="1" x:Name="EdgeBox" SelectedItem="{Binding Edge}" Width="160" HorizontalAlignment="Left" Margin="0,3" />

                            <TextBlock Grid.Row="1" Text="Bar size" Style="{StaticResource Label}" />
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding SizePercent, StringFormat={}{0}%}" />
                                <Slider Minimum="75" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding SizePercent}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Grid.Row="2" Text="Background opacity" Style="{StaticResource Label}" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding BackgroundOpacity, StringFormat={}{0}%}" />
                                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding BackgroundOpacity}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Grid.Row="3" Text="Width on left/right side" Style="{StaticResource Label}" />
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding VerticalWidth, StringFormat={}{0} px}" />
                                <Slider Minimum="48" Maximum="300" TickFrequency="4" IsSnapToTickEnabled="True"
                                        Value="{Binding VerticalWidth}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="100% matches the Windows 10 taskbar (40 px at 100% display scale). The side width is measured at 100% and is also multiplied by the bar size. Turn on window titles for a wide side bar with names." />

                        <CheckBox x:Name="MatchScaleBox" Content="Scale with each monitor's Windows display scale" IsChecked="{Binding MatchWindowsScale}" />
                        <StackPanel Orientation="Horizontal" Margin="24,2,0,6"
                                    IsEnabled="{Binding IsChecked, ElementName=MatchScaleBox, Converter={StaticResource Not}}">
                            <TextBlock Text="Otherwise always use" Style="{StaticResource Label}" />
                            <ComboBox x:Name="FixedScaleBox" SelectedItem="{Binding FixedScalePercent}" Width="90" ItemStringFormat="{}{0}%" />
                        </StackPanel>

                        <CheckBox Content="Show window titles on task buttons" IsChecked="{Binding ShowWindowTitles}" />
                        <CheckBox Content="Blur the desktop behind the bar" IsChecked="{Binding UseBlur}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Behavior">
                    <StackPanel>
                        <CheckBox x:Name="AutoHideBox" Content="Automatically hide the bar (show it when the mouse nears the screen edge)" IsChecked="{Binding AutoHide}" />
                        <DockPanel Margin="24,2,0,6" IsEnabled="{Binding IsChecked, ElementName=AutoHideBox}">
                            <TextBlock Text="Show it when the mouse is within" Style="{StaticResource Label}" />
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding AutoHideRevealDistance, StringFormat={}{0} px}" />
                            <Slider Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding AutoHideRevealDistance}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,6"
                                   Text="An auto-hidden bar also shows over maximized windows. It stays hidden behind real full-screen content like videos and games." />
                        <CheckBox Content="Show the bar when the Start menu opens (Win key)" IsChecked="{Binding ShowBarWithStartMenu}" />
                        <CheckBox Content="Move the Start menu so it doesn't cover the bar" IsChecked="{Binding KeepStartMenuClearOfBar}" />
                        <CheckBox Content="Hide the Windows taskbar while DeskBar is running" IsChecked="{Binding HideWindowsTaskbar}" />
                        <CheckBox x:Name="AllMonitorsBox" Content="Show a bar on every monitor" IsChecked="{Binding ShowOnAllMonitors}" />
                        <CheckBox Content="Each monitor's bar only shows windows that are on that monitor" Margin="24,4,0,4"
                                  IsEnabled="{Binding IsChecked, ElementName=AllMonitorsBox}" IsChecked="{Binding TasksOnOwnMonitorOnly}" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start DeskBar when I sign in to Windows" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Clock">
                    <StackPanel>
                        <CheckBox Content="Show the date under the time" IsChecked="{Binding ShowDate}" />
                        <CheckBox Content="Show seconds" IsChecked="{Binding ShowSeconds}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Search box">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="When I use it" Style="{StaticResource Label}" />
                        <ComboBox Grid.Column="1" x:Name="SearchModeBox" SelectedValue="{Binding SearchMode}"
                                  SelectedValuePath="Tag" Margin="0,3" />

                        <TextBlock Grid.Row="1" Text="Hotkey to send" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SearchHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                        <TextBlock Grid.Row="2" Text="Everything.exe" Style="{StaticResource Label}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                            <Button DockPanel.Dock="Right" Content="Browse…" Padding="8,0" Margin="6,0,0,0" Click="BrowseEverything_Click" />
                            <TextBox x:Name="EverythingPathBox" Text="{Binding EverythingPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="Leave empty to find it automatically. Only used for 'Show all results in Everything'." />

                        <TextBlock Grid.Row="4" Text="Box width" Style="{StaticResource Label}" />
                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SearchBoxWidth}" />
                            <Slider Minimum="120" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SearchBoxWidth}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Grid.Row="5" Text="Results to show" Style="{StaticResource Label}" />
                        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SearchMaxResults}" />
                            <Slider Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SearchMaxResults}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Layout">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Choose where each part of the bar goes and its order. 'Pinned and running apps' fills the space in between." />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button Content="Move up" Padding="10,3" Margin="0,0,0,6" Click="MoveUp_Click" />
                                <Button Content="Move down" Padding="10,3" Click="MoveDown_Click" />
                            </StackPanel>
                            <ListBox x:Name="WidgetList" Height="230" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <ComboBox DockPanel.Dock="Right" Width="110" SelectedItem="{Binding Placement}"
                                                      ItemsSource="{x:Static local:WidgetRow.Placements}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Notification area icons">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Checked icons always show on the bar; the rest go under the ^ button. You can also drag icons between the bar and the ^ flyout." />
                        <ListBox x:Name="TrayList" Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding ShowOnBar}" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
