<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Facetbar</AssemblyName>
    <RootNamespace>Facetbar</RootNamespace>
    <Version>3.0.0</Version>
    <Product>Facetbar</Product>
    <Description>A modular Windows taskbar replacement with per-virtual-desktop pinned apps.</Description>
    <!-- ManagedShell targets net6.0-windows; that asset runs fine on net8. -->
    <!-- WFAC010: the WinForms analyzer wants DPI set in code, but this is a WPF app using the manifest. -->
    <NoWarn>$(NoWarn);NU1701;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, etc.; keep WPF unqualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>

</Project>
